# Copy to .env.local. Only VITE_* variables reach the browser — never put secrets here.
VITE_API_URL=http://localhost:4000

# Demo build ONLY (its own Vercel project, demo.retail-pos.setutechnology.com).
# Shows the shared demo logins (one-tap sign-in per role) on sign-in, sends sign-ups to the real app and
# shows the countdown to the next data reset. VITE_DEMO_LOGIN is inlined into
# the bundle and readable by anyone: only the throwaway demo shop's logins.
# VITE_DEMO_MODE=true
# VITE_DEMO_LOGIN=Owner=owner|demo-shop-1234;Manager=manager|demo-shop-1234;Cashier=cashier|demo-shop-1234
# VITE_PRODUCTION_APP_URL=https://app.retail-pos.setutechnology.com
