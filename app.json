{
  "expo": {
    "name": "Chorely",
    "slug": "chorely",
    "version": "1.0.0",
    "scheme": "chorely",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F7FB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chorely.app",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.chorely.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#5B7CFA",
          "defaultChannel": "chores"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://beujbhpsmapqbwfupkyw.supabase.co",
      "supabaseKey": "sb_publishable_Pg6ofXrz11OAVX3CxSUnAw_W5QW4gTC",
      "router": {},
      "eas": {
        "projectId": "1a73609c-2b90-4780-af8d-53af3bafb70b"
      }
    },
    "owner": "sagarbansal_apps",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1a73609c-2b90-4780-af8d-53af3bafb70b"
    }
  }
}
